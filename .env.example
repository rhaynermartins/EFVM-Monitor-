# Consulta EFVM (valores podem ser nomes exibidos no portal ou IDs numéricos)
EFVM_ORIGIN=Belo Horizonte
EFVM_DESTINATION=Pedro Nolasco (Cariacica / Vitória)
EFVM_TRAVEL_DATE=2026-09-15
EFVM_CLASS=Econômica
EFVM_PASSENGERS=1

# Execução e rede
EFVM_CHECK_INTERVAL_SECONDS=300
EFVM_TIMEOUT_SECONDS=30
EFVM_LOG_LEVEL=INFO
EFVM_WEB_PORT=8000
EFVM_DATABASE_PATH=data/efvm-monitor.db
EFVM_BASE_URL=https://tremdepassageiros.vale.com/sgpweb/rest
EFVM_RAILWAY_CODE=03

# Autenticação web (use true quando a aplicação estiver publicada em HTTPS)
EFVM_COOKIE_SECURE=false

# Opcional: e-mail que poderá assumir uma única vez os dados criados antes da Fase 6
# Defina antes de cadastrar a conta responsável; deixe vazio em instalações novas
EFVM_LEGACY_OWNER_EMAIL=

# Opcional: recebe um POST JSON somente quando houver vaga
ALERT_WEBHOOK_URL=

# Canal principal e gratuito: Web Push padrão com VAPID
WEB_PUSH_ENABLED=true
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email@example.com
WEB_PUSH_MAX_ATTEMPTS=3
WEB_PUSH_TIMEOUT_SECONDS=15

# Canal opcional: WhatsApp Cloud API oficial da Meta
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT_PHONE=
WHATSAPP_API_VERSION=v26.0

# Use um template aprovado para alertas iniciados fora da janela de atendimento
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR

# Retry limitado para falhas temporárias
WHATSAPP_MAX_ATTEMPTS=3
WHATSAPP_RETRY_DELAY_SECONDS=1
WHATSAPP_TIMEOUT_SECONDS=30

# Canal opcional e potencialmente pago: SMS via Twilio
SMS_ENABLED=false
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_RECIPIENT_PHONE=
SMS_DRY_RUN=false
SMS_MAX_ATTEMPTS=3
SMS_TIMEOUT_SECONDS=30
